<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared drop box with the host app. Must match ShareInbox.appGroupID and
	     the App Group on the app target's entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.readymadeit.app-ios</string>
	</array>
</dict>
</plist>
