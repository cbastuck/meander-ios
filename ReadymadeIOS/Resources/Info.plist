<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Readymade</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>Readymade</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Custom scheme the Share Extension uses to hand a captured share off to
	     this app: readymade://share?id=<inbox-item-id>. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.readymadeit.app-ios.share</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>readymade</string>
			</array>
		</dict>
	</array>
	<!-- The board library's iCloud Drive folder, shown as "Readymade" in the
	     Files app and in Finder. Public scope is what makes it visible; iOS
	     reads these keys when the bundle version changes, and the scope of a
	     container is fixed by the first build that uses it. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.readymadeit.readymade</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Readymade</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<!-- Without iCloud Drive, boards stay in the app's Documents; these show
	     that folder in the Files app under On My iPhone › Readymade. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- Keeps the process running in the background while a board is actively
	     playing or recording audio. As a side effect the embedded hkp-rt HTTP
	     server keeps answering LAN requests for as long as audio is running.
	     Legitimate: the Microphone/Speaker services hold an active
	     PlayAndRecord AVAudioSession and run an AVAudioEngine. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Meander uses your location only while a board you run asks for it — for example to share your live position over a link. Location is sent only to the destinations your board defines, and only while the board is running.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Meander uses the microphone only while a board you run asks for it — for example to capture, analyse, or stream audio. Audio is sent only to the destinations your board defines, and only while the board is running.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Meander uses the local network only while you actively look for other Meander instances on the same network, so you can connect them without typing IP addresses.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_readymade._tcp</string>
	</array>
	<key>HKPRuntimeBaseURL</key>
	<string>http://127.0.0.1:5556</string>
	<key>HKPRuntimeRemoteName</key>
	<string>meander-ios</string>
	<key>HKPRuntimeAutoStart</key>
	<true/>
	<key>HKPRuntimePort</key>
	<integer>5556</integer>
	<key>HKPRuntimeAllowedOrigins</key>
	<string>*</string>
	<key>DEV_WEBAPP_URL</key>
	<string>$(DEV_WEBAPP_URL)</string>
</dict>
</plist>
